[Desktop Entry]
Type=Application
X-Nemo-Application-Type=silica-qt5
Icon=harbour-sailtune
Exec=harbour-sailtune
Name=SailTune

[X-Sailjail]
# Changing OrganizationName or ApplicationName moves the app's data
# directories, so keep both stable once released.
OrganizationName=de.tordenskjold
ApplicationName=sailtune
Permissions=Audio;Internet
